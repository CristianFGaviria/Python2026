## Esto eso un tipo de comentario

""" Esto es otro tipo de comentario, donde se puede comentariar todo lo
este entre las comillas"""

## Variables
a = 10
b = 2

## Interaccion entre variables

print(f"Suma 10 + 2 = {a + b}")
print(f"resta 10 - 2 = {a - b}")
print(f"Multiplicacion 10 * 2 = {a * b}")
print(f"Division 10 / 2 = {a / b}")
print(f"Modulo 10 % 2 = {a%b}")
print(f"Division exacta 10 // b = {a // b}")
print(f"Potencia 10 ** 2 = {a ** b}")