## Variables
a = 10
b = 3

## Interaccion entre Operadores

print("############## OPERADORES MATEMATICOS ##############")
print(f"Suma 10 + 2 = {a + b}")
print(f"resta 10 - 2 = {a - b}")
print(f"Multiplicacion 10 * 2 = {a * b}")
print(f"Division 10 / 2 = {a / b}")
print(f"Modulo 10 % 2 = {a % b}")
print(f"Division exacta 10 // b = {a // b}")
print(f"Potencia 10 ** 2 = {a ** b}")

## operaodores de comparacion
print("############## OPERADORES DE COMPARACION ##############")
print(f"igualdad 10 == 2 {a == b}")
print(f"Diferebcia 10 != 2 ={a != b}")
print(f"Menor que 10 < 2 = {a < b}")
print(f"Mayor que 10 > 2 = {a > b}")
print(f"Menor o igual que 10 <= 2 {a <= b}")
print(f"Mayor o igual que 10 >= 2 {a >= b}")

## operadores logicos

print("############## OPERADORES LOGICOS ##############")
print(f"Operador logico AND 10 + 2 = 12 AND 2 - 10 = - 8 = {10 + 2 == 12 and 2 - 10 == -8}")
